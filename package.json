{
  "name": "electron-ai-sdlc",
  "productName": "electron-ai-sdlc",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "agent": "node agent-cli/index.js",
    "pretest": "cd node_modules/better-sqlite3 && node ../../node_modules/prebuild-install/bin.js --runtime electron --target 41.2.0 --platform win32 --arch x64 --tag-prefix v",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report tests/e2e/reports"
  },
  "keywords": [],
  "author": {
    "name": "Shafiullah",
    "email": "sms.shafi@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.60.0",
    "electron": "41.2.0"
  }
}
