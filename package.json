{
  "name": "devflow-ai-sdlc",
  "productName": "DevFlow AI",
  "version": "0.1.0",
  "description": "AI-powered SDLC companion — plan, design, build and test software projects with local or cloud AI models.",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "agent": "node agent-cli/index.js",
    "clear-settings": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/clear-settings.js",
    "pretest": "cd node_modules/better-sqlite3 && node ../../node_modules/prebuild-install/bin.js --runtime electron --target 41.2.0 --platform win32 --arch x64 --tag-prefix v",
    "test": "playwright test",
    "test:watch": "cross-env PW_HEADED=1 PW_SLOW_MO=800 playwright test",
    "test:debug": "cross-env PWDEBUG=1 playwright test",
    "test:report": "playwright show-report tests/e2e/reports",
    "test:headed": "cross-env PW_HEADED=1 playwright test"
  },
  "keywords": [],
  "author": {
    "name": "Shafiullah",
    "email": "sms.shafi@gmail.com"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.3",
    "node-pty": "^1.1.0",
    "xterm": "^4.19.0",
    "xterm-addon-fit": "^0.5.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.60.0",
    "cross-env": "^10.1.0",
    "electron": "41.2.0",
    "electron-forge-maker-nsis": "^26.8.1",
    "sharp": "^0.34.5"
  }
}
